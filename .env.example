# Copy this file to .env and replace each placeholder with your local values.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/auth/callback

# Optional local frontend API origin. Leave empty on Vercel same-origin deployment.
VITE_API_URL=http://127.0.0.1:3001
